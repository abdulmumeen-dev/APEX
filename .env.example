# Application server
PORT=3000
NODE_ENV=development

# MySQL database used by APEX's persistent workspace.
DATABASE_URL=

# Authentication mode:
# - manus (default): use the managed Manus OAuth/session integration in hosted Preview.
# - local: use one self-hosted owner account; set the variables below first.
APEX_AUTH_MODE=manus

# Manus OAuth/session values are platform-provided in managed Preview.
# Self-hosted local mode does not need these Manus-specific values.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
OWNER_OPEN_ID=
MANUS_API_URL=
MANUS_API_KEY=

# Optional single-owner login for a self-hosted APEX instance.
# Generate a password hash interactively with `pnpm hash-password`; do not store a plaintext password.
APEX_LOCAL_USERNAME=apex-owner
APEX_LOCAL_PASSWORD_HASH=
# Generate a fresh signing secret with `openssl rand -base64 32`.
APEX_LOCAL_SESSION_SECRET=
APEX_LOCAL_DISPLAY_NAME=APEX Owner
APEX_LOCAL_EMAIL=
# Keep true for HTTPS. Set false only for a private, loopback-only HTTP development instance.
APEX_COOKIE_SECURE=true

# Required before storing any user-supplied model or bridge API key.
# Generate 32 cryptographically random bytes and encode as 64 hex characters or Base64.
APEX_ENCRYPTION_KEY=

# Keep false for hosted/public deployments. Enable only on a trusted self-hosted
# instance that intentionally connects to private/local model or bridge endpoints.
APEX_ALLOW_PRIVATE_ENDPOINTS=false

# Optional local CLI model configuration. Keep API keys in the process environment, not a tracked file.
# Example endpoint: http://localhost:11434/v1 (use a model that supports tool calling).
APEX_MODEL_BASE_URL=
APEX_MODEL_ID=
APEX_MODEL_API_KEY=
